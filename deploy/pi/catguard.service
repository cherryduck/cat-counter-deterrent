[Unit]
Description=Cat Guard (Kinect cat-on-counter deterrent)
After=network-online.target remote-fs.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=cherryduck
WorkingDirectory=/home/cherryduck/catguard
ExecStart=/home/cherryduck/catguard/.venv/bin/catguard -c /home/cherryduck/catguard/config.toml run
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
